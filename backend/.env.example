# =============================================================================
# RAG System - Backend environment variables (EXAMPLE ONLY)
#
# Copy this file to backend/.env and fill in real values.
# NEVER commit your real .env to git (it is already in .gitignore).
# NEVER put real API keys in this file - placeholders only.
# =============================================================================

# --- Database (Neon PostgreSQL with pgvector) ---
# Example placeholder - use your own Neon connection string.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# --- Embeddings (Gemini Embedding 2, 768 dimensions) ---
# DO NOT change these - the pgvector schema is tied to 768 dimensions.
# These values also drive the document ingestion pipeline.
EMBEDDING_MODEL=gemini
EMBEDDING_MODEL_NAME=gemini-embedding-2
EMBEDDING_DIMENSION=768

# Alternative embedding modes (kept for reference - NOT part of the retrieval pipeline):
# EMBEDDING_MODEL=openrouter            # + OPENROUTER_API_KEY=your_api_key_here
# EMBEDDING_MODEL=sentence-transformers # + EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2 (local)
# EMBEDDING_MODEL=simple-hash           # dev/testing only, no external service

# --- Gemini API key (used for embeddings AND primary LLM) ---
# Get your API key from https://ai.google.dev/
GEMINI_API_KEY=your-gemini-api-key-here

# --- Gemini LLM (answer generation - PRIMARY) ---
GEMINI_LLM_MODEL=gemini-3.8-flash
GEMINI_LLM_TEMPERATURE=0.2
GEMINI_LLM_MAX_OUTPUT_TOKENS=1024

# Retry transient Gemini generation errors (503 high demand, 429, 5xx)
# with exponential backoff before using the OpenRouter fallback.
GEMINI_LLM_MAX_RETRIES=3
GEMINI_LLM_RETRY_BASE_DELAY=1.0
GEMINI_LLM_RETRY_MAX_DELAY=8.0

# --- Nemotron Ultra fallback LLM via OpenRouter (generation ONLY) ---
# Used ONLY when the Gemini LLM call fails (e.g. 503 high demand).
# Never used for embeddings (unless EMBEDDING_MODEL=openrouter), ingestion,
# retrieval or authentication.
# Get a key at https://openrouter.ai/ (OpenRouter API key).
# Used when Gemini stays down after the transient-error retries.
OPENROUTER_API_KEY=
OPENROUTER_LLM_MODEL=nvidia/nemotron-3-ultra-550b-a55b
OPENROUTER_LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_FALLBACK_ENABLED=true

# --- RAG pipeline defaults ---
RAG_TOP_K=5
RAG_MIN_SIMILARITY=0.3
RAG_MAX_CONTEXT_CHARS=12000

# --- JWT Authentication ---
JWT_SECRET_KEY=changeme-generate-a-real-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- Document ingestion (chunking) ---
CHUNK_SIZE=1000
CHUNK_OVERLAP=150

# --- Upload safety limits (DoS protection) ---
MAX_UPLOAD_SIZE_MB=20
MAX_PAGES_PER_DOC=500
MAX_CHUNKS_PER_DOC=2000
MAX_FILENAME_CHARS=255

# --- Retrieval override (used by ingestion-side tooling; RAG_TOP_K is canonical) ---
TOP_K=5

# --- CORS (frontend dev server) ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Application ---
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=true

# --- WebSocket debug logging (optional) ---
# Set to 1 to log exactly which WS messages are yielded.
DEBUG_WS_FLOW=
